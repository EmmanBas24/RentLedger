{
  "expo": {
    "name": "RentLedger",
    "slug": "RentLedger",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "rentledger",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.eryxe15.RentLedger"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "12173382-eb5a-40cf-ae49-202e3d79002e"
      }
    }
  }
}
